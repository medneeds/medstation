# Variáveis acrescentadas ao ~/.hermes/.env (modo 600) do usuário `hermes`.
# Escrito pelo Claude em 24/11/2026. Este arquivo traz só nomes e valores não
# sigilosos; os segredos ficam apenas na VPS.

# --- API do Hermes (website/docs/user-guide/features/api-server.md) ---
API_SERVER_ENABLED=true
API_SERVER_HOST=127.0.0.1
API_SERVER_PORT=8642
# Gerada na VPS com `openssl rand -hex 32`. Nunca copiar para o Git ou para o chat.
API_SERVER_KEY=

# --- Ponte MCP da MedStation (docs/medstation-ai-core-phase5-preflight.md) ---
MEDSTATION_MCP_STAGING_ENABLED=true
MEDSTATION_STAGING_PROJECT_REF=qcvvwbbeuvawgccstyro
# Ref de produção: usado só para a ponte recusar qualquer URL que aponte para ele.
MEDSTATION_PRODUCTION_PROJECT_REF=rwiovxyftfbkvzbepfqi
MEDSTATION_STAGING_URL=https://qcvvwbbeuvawgccstyro.supabase.co/functions/v1/ai-core-hermes-sandbox
# Chave pública (anon) do projeto de homologação.
MEDSTATION_SUPABASE_ANON_KEY=
# JWT de sessão do admin fictício. Dura 1 hora e NÃO é gravado no .env:
# o script validar-ponte-homologacao.sh entrega o valor só em memória.
# MEDSTATION_STAGING_JWT=
